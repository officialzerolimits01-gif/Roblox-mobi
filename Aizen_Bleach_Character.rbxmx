    <Item class="Script" referent="RBX509">
      <Properties>
        <string name="Name">AizenAbilityServer</string>
        <ProtectedString name="Source">-- AIZEN: server-side ability controller. Keep this Script inside AizenCharacter.
local character = script.Parent
local remote = character:WaitForChild("Remotes"):WaitForChild("UseAbility")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local cooldowns = {}
local abilities = {
    FlashStep = {cd=4, range=24}, BlackCoffin={cd=12, range=18, damage=35}, KyokaSuisugetsu={cd=18, range=22, damage=24}, Hado90={cd=30, range=28, damage=65}
}
local function effectSphere(pos, color, size, duration)
    local p=Instance.new("Part"); p.Shape=Enum.PartType.Ball; p.Anchored=true; p.CanCollide=false; p.Material=Enum.Material.Neon; p.Color=color; p.Size=Vector3.new(size,size,size); p.CFrame=CFrame.new(pos); p.Transparency=.2; p.Parent=workspace
    game:GetService("TweenService"):Create(p,TweenInfo.new(duration),{Size=p.Size*2.5,Transparency=1}):Play(); Debris:AddItem(p,duration+.1)
end
local function targetHumanoids(center, radius, damage)
    local hit={}
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health&gt;0 and obj.Parent~=character then
            local hrp=obj.Parent:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position-center).Magnitude&lt;=radius and not hit[obj] then hit[obj]=true; obj:TakeDamage(damage) end
        end
    end
end
remote.OnServerEvent:Connect(function(player, ability)
    if typeof(ability)~="string" or not abilities[ability] then return end
    if not character:IsDescendantOf(workspace) then return end
    local owner=Players:GetPlayerFromCharacter(character)
    if owner and owner~=player then return end
    local hum=character:FindFirstChildOfClass("Humanoid"); local root=character:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health&lt;=0 or not root then return end
    cooldowns[player]=cooldowns[player] or {}
    local now=os.clock(); local data=abilities[ability]
    if cooldowns[player][ability] and now-cooldowns[player][ability]&lt;data.cd then return end
    cooldowns[player][ability]=now
    if ability=="FlashStep" then
        local direction=root.CFrame.LookVector; root.CFrame=root.CFrame+direction*data.range
        effectSphere(root.Position,Color3.fromRGB(180,80,255),3,.35)
    elseif ability=="BlackCoffin" then
        local pos=root.Position+root.CFrame.LookVector*10; effectSphere(pos,Color3.fromRGB(90,30,160),7,1.2); targetHumanoids(pos, data.range, data.damage)
    elseif ability=="KyokaSuisugetsu" then
        local pos=root.Position+root.CFrame.LookVector*12; effectSphere(pos,Color3.fromRGB(170,110,255),9,1); targetHumanoids(pos,data.range,data.damage)
    elseif ability=="Hado90" then
        local pos=root.Position+root.CFrame.LookVector*16; effectSphere(pos,Color3.fromRGB(35,0,65),12,1.8); targetHumanoids(pos,data.range,data.damage)
    end
end)
Players.PlayerRemoving:Connect(function(p) cooldowns[p]=nil end)
</ProtectedString>
      </Properties>
    </Item>
    <Item class="LocalScript" referent="RBX513">
      <Properties>
        <string name="Name">AizenMovesClient</string>
        <ProtectedString name="Source">-- Move this LocalScript to StarterPlayer &gt; StarterPlayerScripts after inserting the model.
-- Controls: Z Flash Step, X Black Coffin, C Kyoka Suigetsu, V Hado 90.
local Players=game:GetService("Players")
local UIS=game:GetService("UserInputService")
local player=Players.LocalPlayer
local function getRemote()
    local char=workspace:FindFirstChild("AizenCharacter") or player.Character
    if not char then return nil end
    local folder=char:FindFirstChild("Remotes")
    return folder and folder:FindFirstChild("UseAbility")
end
local gui=Instance.new("ScreenGui"); gui.Name="AizenMovesGUI"; gui.ResetOnSpawn=false; gui.Parent=player:WaitForChild("PlayerGui")
local frame=Instance.new("Frame",gui); frame.Name="Moves"; frame.AnchorPoint=Vector2.new(1,1); frame.Position=UDim2.new(1,-18,1,-25); frame.Size=UDim2.fromOffset(205,190); frame.BackgroundColor3=Color3.fromRGB(20,12,35); frame.BackgroundTransparency=.12
Instance.new("UICorner",frame).CornerRadius=UDim.new(0,14)
local stroke=Instance.new("UIStroke",frame); stroke.Color=Color3.fromRGB(170,90,255); stroke.Thickness=2
local title=Instance.new("TextLabel",frame); title.Size=UDim2.new(1,0,0,30); title.BackgroundTransparency=1; title.Text="AIZEN • MOVES"; title.TextColor3=Color3.fromRGB(220,190,255); title.Font=Enum.Font.GothamBold; title.TextSize=15
local moves={{"Z","Flash Step","FlashStep"},{"X","Black Coffin","BlackCoffin"},{"C","Kyoka Suigetsu","KyokaSuisugetsu"},{"V","Hado 90","Hado90"}}
local buttons={}
local function use(name)
    local r=getRemote(); if r then r:FireServer(name) end
end
for i,m in ipairs(moves) do
    local b=Instance.new("TextButton",frame); b.Size=UDim2.new(1,-16,0,32); b.Position=UDim2.fromOffset(8,32+(i-1)*37); b.BackgroundColor3=Color3.fromRGB(65,35,100); b.Text=m[1].."  •  "..m[2]; b.TextColor3=Color3.new(1,1,1); b.Font=Enum.Font.GothamSemibold; b.TextSize=13; Instance.new("UICorner",b).CornerRadius=UDim.new(0,8); b.Activated:Connect(function() use(m[3]) end); buttons[m[1]]=m[3]
end
UIS.InputBegan:Connect(function(input,processed)
    if processed then return end
    if input.KeyCode==Enum.KeyCode.Z then use("FlashStep") elseif input.KeyCode==Enum.KeyCode.X then use("BlackCoffin") elseif input.KeyCode==Enum.KeyCode.C then use("KyokaSuisugetsu") elseif input.KeyCode==Enum.KeyCode.V then use("Hado90") end
end)
</ProtectedString>
